{
  "$defs": {
    "ChoiceRule": {
      "description": "How a part chooses among the targets of an edge, the list being the preference. Default first_free.",
      "enum": [
        "first_free",
        "shortest_queue",
        "lowest_utilization",
        "preferred"
      ]
    },
    "Component": {
      "description": "A component: `id`, `type` and the parameters of that type.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "capacity": {
              "$ref": "#/$defs/Count",
              "description": "The places of the buffer, at least 1. A buffer of no places is a direct edge."
            },
            "discipline": {
              "description": "Which part leaves first: first into the buffer, last into it, or highest priority, then first into it. Default fifo.",
              "enum": [
                "fifo",
                "lifo",
                "priority"
              ]
            },
            "id": {
              "$ref": "#/$defs/ComponentId"
            },
            "type": {
              "const": "Buffer"
            }
          },
          "required": [
            "id",
            "type",
            "capacity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capacity": {
              "$ref": "#/$defs/Count",
              "description": "From 1 to 65535 parts."
            },
            "cycle_time": {
              "$ref": "#/$defs/Distribution",
              "description": "The time one unit takes, drawn when its cycle starts. A bare duration is a constant."
            },
            "cycle_time_by_variant": {
              "additionalProperties": {
                "$ref": "#/$defs/Distribution",
                "description": "The time one unit takes, drawn when its cycle starts. A bare duration is a constant."
              },
              "description": "The time one unit of a variant takes, instead of `cycle_time`, from the same stream. Each is a variant some Source declares, and not a constant 0s.",
              "propertyNames": {
                "$ref": "#/$defs/ComponentId"
              },
              "type": "object"
            },
            "id": {
              "$ref": "#/$defs/ComponentId"
            },
            "mtbf": {
              "$ref": "#/$defs/Distribution",
              "description": "The up time from the end of a repair (or time zero) to the next failure, in calendar time. A bare duration is a constant: the machine fails on a fixed schedule, so name a distribution unless regular failures are meant. Comes with `mttr`."
            },
            "mttr": {
              "$ref": "#/$defs/Distribution",
              "description": "The time a repair takes, drawn at each failure. A bare duration is a constant. Comes with `mtbf`."
            },
            "setup": {
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "per_variant"
                  ]
                },
                {
                  "required": [
                    "matrix"
                  ]
                }
              ],
              "description": "Changeover times. The first unit costs none; a unit of another variant takes the `matrix` entry for that change, otherwise `per_variant`, otherwise none.",
              "properties": {
                "matrix": {
                  "description": "The changeover time of each listed change of variant. `0s` means the change costs nothing: no timer, no `setup` state.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "$ref": "#/$defs/ComponentId",
                        "description": "A variant name, declared by some Source."
                      },
                      "time": {
                        "$ref": "#/$defs/Distribution"
                      },
                      "to": {
                        "$ref": "#/$defs/ComponentId",
                        "description": "A variant name, declared by some Source."
                      }
                    },
                    "required": [
                      "from",
                      "to",
                      "time"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "per_variant": {
                  "$ref": "#/$defs/Distribution",
                  "description": "The changeover time of any change of variant the `matrix` does not list."
                }
              },
              "type": "object"
            },
            "type": {
              "const": "Machine"
            }
          },
          "required": [
            "id",
            "type",
            "cycle_time"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/ComponentId"
            },
            "type": {
              "const": "Sink"
            }
          },
          "required": [
            "id",
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "batch": {
              "$ref": "#/$defs/Count",
              "description": "From 1 to 65535 parts."
            },
            "id": {
              "$ref": "#/$defs/ComponentId"
            },
            "interarrival": {
              "$ref": "#/$defs/Distribution",
              "description": "The time between batches, counted from the last part of the batch leaving. Absent: the Source makes a part whenever the next component takes one. A bare duration is a constant."
            },
            "priority": {
              "description": "The priority of its parts in a buffer with the `priority` discipline: higher goes first, default 0.",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": {
              "const": "Source"
            },
            "variants": {
              "additionalProperties": {
                "$ref": "#/$defs/Ratio"
              },
              "description": "The share of each variant, each above 0 %, summing to 100 %. One variant and one priority per batch. Default: one variant, `default`.",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/ComponentId"
              },
              "type": "object"
            }
          },
          "required": [
            "id",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ComponentId": {
      "description": "A component id: letters, digits and `_`, starting with a letter or `_`, optionally joined by single `-` (ADR-0015).",
      "examples": [
        "cut",
        "weld-1"
      ],
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(-[A-Za-z0-9_]+)*$",
      "type": "string"
    },
    "Control": {
      "additionalProperties": false,
      "description": "Control logic: the dispatching rule of each station (ADR-0023).",
      "properties": {
        "dispatch": {
          "additionalProperties": {
            "$ref": "#/$defs/DispatchRule"
          },
          "propertyNames": {
            "$ref": "#/$defs/ComponentId"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Count": {
      "description": "A whole number of parts.",
      "examples": [
        "20 parts",
        "1 part"
      ],
      "pattern": "^[0-9]+(\\.0+)? ?parts?$",
      "type": "string"
    },
    "DispatchRule": {
      "description": "Which waiting unit the station takes next.",
      "enum": [
        "fifo",
        "earliest_due_date",
        "shortest_processing_time",
        "minimum_setup",
        "priority_class"
      ]
    },
    "Distribution": {
      "description": "A duration (a constant), or a distribution named by `dist` with named parameters (ADR-0003).",
      "oneOf": [
        {
          "$ref": "#/$defs/Duration",
          "description": "A constant duration."
        },
        {
          "additionalProperties": false,
          "description": "Exponential with the given mean.",
          "properties": {
            "dist": {
              "const": "exponential"
            },
            "mean": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "dist",
            "mean"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Normal, truncated at zero by rejection (ADR-0013).",
          "properties": {
            "dist": {
              "const": "normal"
            },
            "mean": {
              "$ref": "#/$defs/Duration"
            },
            "sd": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "dist",
            "mean",
            "sd"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lognormal: `mean` is the distribution's mean, `sigma` the standard deviation of its logarithm.",
          "properties": {
            "dist": {
              "const": "lognormal"
            },
            "mean": {
              "$ref": "#/$defs/Duration"
            },
            "sigma": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "dist",
            "mean",
            "sigma"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Uniform between `min` and `max`.",
          "properties": {
            "dist": {
              "const": "uniform"
            },
            "max": {
              "$ref": "#/$defs/Duration"
            },
            "min": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "dist",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Triangular with `min <= mode <= max`.",
          "properties": {
            "dist": {
              "const": "triangular"
            },
            "max": {
              "$ref": "#/$defs/Duration"
            },
            "min": {
              "$ref": "#/$defs/Duration"
            },
            "mode": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "dist",
            "min",
            "mode",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Gamma with the given mean and coefficient of variation.",
          "properties": {
            "cv": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "dist": {
              "const": "gamma"
            },
            "mean": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "dist",
            "mean",
            "cv"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Erlang: the sum of `k` exponential phases.",
          "properties": {
            "dist": {
              "const": "erlang"
            },
            "k": {
              "maximum": 4294967295,
              "minimum": 1,
              "type": "integer"
            },
            "mean": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "dist",
            "mean",
            "k"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Weibull.",
          "properties": {
            "dist": {
              "const": "weibull"
            },
            "scale": {
              "$ref": "#/$defs/Duration"
            },
            "shape": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "dist",
            "scale",
            "shape"
          ],
          "type": "object"
        }
      ]
    },
    "Duration": {
      "description": "A duration: a number and one of the units d, h, min, s, ms, with at most one space; exact to the nanosecond.",
      "examples": [
        "42s",
        "12min",
        "0.5h",
        "8h"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)? ?(d|h|min|s|ms)$",
      "type": "string"
    },
    "EdgeEnd": {
      "description": "A component id, or a list of different ones.",
      "oneOf": [
        {
          "$ref": "#/$defs/ComponentId"
        },
        {
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      ]
    },
    "Experiment": {
      "additionalProperties": false,
      "description": "How the model is run: a terminating experiment over `horizon`, with optional relative precision targets per observable (ADR-0014).",
      "properties": {
        "horizon": {
          "$ref": "#/$defs/Duration"
        },
        "precision": {
          "additionalProperties": {
            "$ref": "#/$defs/Ratio"
          },
          "propertyNames": {
            "$ref": "#/$defs/ObservableRef"
          },
          "type": "object"
        },
        "type": {
          "const": "terminating"
        }
      },
      "required": [
        "type",
        "horizon"
      ],
      "type": "object"
    },
    "FlowEntry": {
      "description": "A chain of at least two components, or an edge from one or several components to one or several components (branch, merge, loop-back).",
      "oneOf": [
        {
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "minItems": 2,
          "type": "array"
        },
        {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "choose": {
                  "$ref": "#/$defs/ChoiceRule"
                },
                "from": {
                  "$ref": "#/$defs/EdgeEnd"
                },
                "to": {
                  "$ref": "#/$defs/EdgeEnd"
                },
                "when": {
                  "description": "A boolean expression over the part's attributes (ADR-0009, ADR-0023). A part takes the first edge whose condition holds, in the order written, and the last edge leaving a component has none. The loader checks its type.",
                  "examples": [
                    "variant == 'premium'"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "$ref": "#/$defs/EdgeEnd"
                },
                "split": {
                  "additionalProperties": {
                    "$ref": "#/$defs/Ratio"
                  },
                  "description": "The share of each target, each above 0 %, summing to 100 %. A part takes one target by one draw and waits for it when it is full.",
                  "minProperties": 2,
                  "propertyNames": {
                    "$ref": "#/$defs/ComponentId"
                  },
                  "type": "object"
                },
                "when": {
                  "description": "A boolean expression over the part's attributes (ADR-0009, ADR-0023). A part takes the first edge whose condition holds, in the order written, and the last edge leaving a component has none. The loader checks its type.",
                  "examples": [
                    "variant == 'premium'"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "from",
                "split"
              ],
              "type": "object"
            }
          ]
        }
      ]
    },
    "Include": {
      "description": "A file whose components, flow and observables come before the model's own; optionally pinned to the SHA-256 of its content.",
      "oneOf": [
        {
          "description": "A path relative to the model file, with `/` separators, in its directory or below, to a .yaml, .yml or .json file.",
          "examples": [
            "cells/welding.yaml"
          ],
          "pattern": "^(?:(?:[A-Za-z0-9_-]|\\.[A-Za-z0-9_-]|\\.\\.[A-Za-z0-9._-])[A-Za-z0-9._-]*/)*[A-Za-z0-9._-]*\\.(?:[Yy][Aa]?[Mm][Ll]|[Jj][Ss][Oo][Nn])$",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "A path relative to the model file, with `/` separators, in its directory or below, to a .yaml, .yml or .json file.",
              "examples": [
                "cells/welding.yaml"
              ],
              "pattern": "^(?:(?:[A-Za-z0-9_-]|\\.[A-Za-z0-9_-]|\\.\\.[A-Za-z0-9._-])[A-Za-z0-9._-]*/)*[A-Za-z0-9._-]*\\.(?:[Yy][Aa]?[Mm][Ll]|[Jj][Ss][Oo][Nn])$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "IncludedFile": {
      "additionalProperties": false,
      "description": "A file named in `include:`.",
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "type": "array"
        },
        "flow": {
          "items": {
            "$ref": "#/$defs/FlowEntry"
          },
          "type": "array"
        },
        "observe": {
          "items": {
            "$ref": "#/$defs/Observable"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Model": {
      "additionalProperties": false,
      "description": "The model's name and defaults.",
      "properties": {
        "name": {
          "examples": [
            "line-a"
          ],
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(-[A-Za-z0-9_]+)*$",
          "type": "string"
        },
        "seed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "time_unit": {
          "enum": [
            "d",
            "h",
            "min",
            "s",
            "ms"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Observable": {
      "description": "An observable: a call of lead_time, state_shares, throughput, wip on component ids, e.g. `lead_time(sink)` (ADR-0009, ADR-0015). The loader checks its arguments and type.",
      "pattern": "^[ \\t]*(lead_time|state_shares|throughput|wip)[ \\t]*\\(",
      "type": "string"
    },
    "ObservableRef": {
      "description": "A reference to an observable: a call on component ids, e.g. `throughput(sink)`. The schema only requires the shape of a call; the loader checks that the catalog declares the function, and its arguments and type.",
      "pattern": "^[ \\t]*[A-Za-z_][A-Za-z0-9_]*[ \\t]*\\(",
      "type": "string"
    },
    "Ratio": {
      "description": "A percentage.",
      "examples": [
        "2%",
        "0.5%"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)? ?%$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A taktsim model (spec §4) of the standard production catalog: Source, Machine, Buffer, Sink. Generated from the Rust types; do not edit.",
  "if": {
    "not": {
      "required": [
        "include"
      ]
    }
  },
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "type": "array"
    },
    "control": {
      "$ref": "#/$defs/Control"
    },
    "experiment": {
      "$ref": "#/$defs/Experiment"
    },
    "flow": {
      "items": {
        "$ref": "#/$defs/FlowEntry"
      },
      "type": "array"
    },
    "format": {
      "const": "1.0",
      "description": "The format version (ADR-0008); quote it."
    },
    "include": {
      "items": {
        "$ref": "#/$defs/Include"
      },
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/Model"
    },
    "observe": {
      "items": {
        "$ref": "#/$defs/Observable"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "model",
    "experiment"
  ],
  "then": {
    "properties": {
      "components": {
        "minItems": 1
      },
      "flow": {
        "minItems": 1
      }
    },
    "required": [
      "components",
      "flow"
    ]
  },
  "title": "taktsim model, format 1.0",
  "type": "object"
}
