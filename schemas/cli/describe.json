    {
      "arguments": [
        {
          "allowed": [],
          "help": "The model file, `.yaml`, `.yml` or `.json`",
          "name": "<model>",
          "positional": true,
          "required": true,
          "takes_value": true,
          "type": "path"
        },
        {
          "allowed": [],
          "help": "The seed, over `model.seed`; a model that draws nothing has none. Repeat it, or give a range such as `1..20`, for an experiment over several seeds; with `experiment.precision`, one seed is the first of a sequence",
          "name": "--seed",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "seeds"
        },
        {
          "allowed": [],
          "help": "Another horizon: a new version of the model, with its own hash",
          "name": "--horizon",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "duration"
        },
        {
          "allowed": [],
          "help": "The run store; otherwise the nearest `.taktsim/` upward, else one here",
          "name": "--store",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "path"
        },
        {
          "allowed": [],
          "help": "The most events to process; a run stopped by it is partial and exits 3",
          "name": "--max-events",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "integer"
        },
        {
          "allowed": [],
          "help": "The most replications of an experiment; required with `experiment.precision` and for more than 1000 seeds",
          "name": "--max-runs",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "integer"
        },
        {
          "allowed": [],
          "help": "The most wall-clock seconds of an experiment; required with `experiment.precision` and for more than 1000 seeds. Only how many replications count depends on it",
          "name": "--max-seconds",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "integer"
        },
        {
          "allowed": [],
          "help": "Run even if the store has this run, and compare; it is never overwritten",
          "name": "--no-reuse",
          "positional": false,
          "required": false,
          "takes_value": false,
          "type": "boolean"
        },
        {
          "allowed": [
            "text",
            "json"
          ],
          "default": "text",
          "help": "How to print the result: `json` is one document on stdout and JSON Lines on stderr",
          "name": "--format",
          "positional": false,
          "required": false,
          "takes_value": true,
          "type": "enum"
        }
      ],
      "budget": {
        "flags": [
          "--max-runs",
          "--max-seconds"
        ],
        "max_seeds": 100000,
        "required": "both, with `experiment.precision`, and for a list of more than 1000 seeds; a shorter list is its own budget",
        "short_list": 1000
      },
      "example": "taktsim run line.yaml --seed 42 --horizon 8h --format json",
      "exit_codes": [
        {
          "code": 0,
          "error_types": []
        },
        {
          "code": 1,
          "error_types": [
            "args.*",
            "model.*",
            "run.no_seed",
            "run.seed_out_of_range",
            "run.duplicate_seed",
            "run.no_budget",
            "run.budget_too_small",
            "run.budget_too_large",
            "run.seed_list_with_precision",
            "run.build"
          ]
        },
        {
          "code": 2,
          "error_types": [
            "run.component_failed",
            "run.invariant_violated",
            "run.conservation_violated",
            "run.item_not_received",
            "run.engine",
            "run.failed",
            "run.metrics_differ",
            "run.stalled",
            "run.no_draw_claim_false",
            "run.store_differs",
            "run.trace_format",
            "run.replay_differs",
            "run.kpi_conservation",
            "run.kpi_undeclared_state",
            "run.kpi_no_end",
            "run.windows_differ"
