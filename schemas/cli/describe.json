              "half_width",
              "std_dev",
              "replications",
              "level"
            ],
            "type": "object"
          },
          "Sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "TraceRef": {
            "properties": {
              "bytes": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "message_format": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "record_format": {
                "type": "string"
              },
              "stream_hash": {
                "$ref": "#/$defs/Sha256"
              },
              "trace_format": {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "bytes",
              "trace_format",
              "record_format",
              "message_format",
              "stream_hash"
            ],
            "type": "object"
          },
          "Unreported": {
            "properties": {
              "observable": {
