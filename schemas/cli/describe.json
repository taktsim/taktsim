            },
            "required": [
              "complete",
              "stop_reason",
              "end_time",
              "events",
              "records"
            ],
            "type": "object"
          },
          "SamplingInterval": {
            "properties": {
              "half_width": {
                "type": "number"
              },
              "level": {
                "type": "number"
              },
              "mean": {
                "type": "number"
              },
              "replications": {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              "std_dev": {
                "type": "number"
              },
              "stopping": {
                "type": "string"
