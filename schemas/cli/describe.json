              },
              "package": {
                "type": "string"
              },
              "package_version": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "seeds": {
                "items": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "system_hash": {
                "$ref": "#/$defs/Sha256"
              }
