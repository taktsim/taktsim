              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "observable",
              "reason"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The result of a run (ADR-0024 §3). Readers use `complete` to decide and ignore unknown keys.",
